NODE_ENV=development
DEMO_MODE=true
AUTO_APPROVE_DOCTOR_SIGNUPS=false
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=5050
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ISSUER=glycotwin-api
JWT_AUDIENCE=glycotwin-clients
BCRYPT_ROUNDS=12
FRONTEND_ORIGIN=http://localhost:3000

B2_BUCKET=glycotwin-private-dev
B2_ENDPOINT=https://s3.<your-region>.backblazeb2.com
B2_KEY_ID=...
B2_APPLICATION_KEY=...